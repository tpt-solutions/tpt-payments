<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TPT Credit Testnet Faucet</title>
  <style>
    :root {
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --bg: #0f172a;
      --card-bg: #1e293b;
      --text: #f1f5f9;
      --text-muted: #94a3b8;
      --border: #334155;
      --success: #22c55e;
      --error: #ef4444;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }
    .container {
      max-width: 480px;
      width: 100%;
    }
    .logo {
      text-align: center;
      margin-bottom: 2rem;
    }
    .logo h1 {
      font-size: 1.75rem;
      font-weight: 700;
      background: linear-gradient(135deg, #60a5fa, #a78bfa);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .logo p {
      color: var(--text-muted);
      margin-top: 0.5rem;
      font-size: 0.875rem;
    }
    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 1rem;
      padding: 2rem;
      margin-bottom: 1rem;
    }
    .card h2 {
      font-size: 1.25rem;
      margin-bottom: 0.5rem;
    }
    .card p {
      color: var(--text-muted);
      font-size: 0.875rem;
      margin-bottom: 1.5rem;
    }
    .form-group {
      margin-bottom: 1rem;
    }
    label {
      display: block;
      font-size: 0.875rem;
      font-weight: 500;
      margin-bottom: 0.5rem;
      color: var(--text);
    }
    input[type="text"] {
      width: 100%;
      padding: 0.75rem 1rem;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      color: var(--text);
      font-size: 0.875rem;
      font-family: monospace;
      transition: border-color 0.2s;
    }
    input[type="text"]:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }
    button {
      width: 100%;
      padding: 0.875rem;
      background: var(--primary);
      color: white;
      border: none;
      border-radius: 0.5rem;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
    }
    button:hover { background: var(--primary-dark); }
    button:active { transform: scale(0.98); }
    button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .info {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 0.75rem;
      text-align: center;
    }
    .alert {
      padding: 0.875rem;
      border-radius: 0.5rem;
      margin-bottom: 1rem;
      font-size: 0.875rem;
      display: none;
    }
    .alert-success {
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid var(--success);
      color: var(--success);
      display: block;
    }
    .alert-error {
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid var(--error);
      color: var(--error);
      display: block;
    }
    .tx-hash {
      font-family: monospace;
      font-size: 0.75rem;
      word-break: break-all;
      color: var(--primary);
      margin-top: 0.5rem;
    }
    .stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
      margin-top: 1.5rem;
    }
    .stat {
      background: var(--bg);
      padding: 0.75rem;
      border-radius: 0.5rem;
      text-align: center;
    }
    .stat .value {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--primary);
    }
    .stat .label {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 0.25rem;
    }
    .footer {
      text-align: center;
      color: var(--text-muted);
      font-size: 0.75rem;
      margin-top: 2rem;
    }
    .footer a { color: var(--primary); text-decoration: none; }
    .footer a:hover { text-decoration: underline; }
    .loading {
      display: inline-block;
      width: 1rem;
      height: 1rem;
      border: 2px solid rgba(255,255,255,0.3);
      border-radius: 50%;
      border-top-color: white;
      animation: spin 0.6s linear infinite;
      vertical-align: middle;
      margin-right: 0.5rem;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>
  <div class="container">
    <div class="logo">
      <h1>TPT Credit Testnet</h1>
      <p>Faucet — Get testnet credits for development</p>
    </div>

    <div class="card">
      <h2>Request Credits</h2>
      <p>Enter your testnet address to receive <strong><%= amount %></strong> testnet credits. Limited to one request per address per 24 hours.</p>

      <div id="alert" class="alert" style="display: none;"></div>

      <form id="claimForm">
        <div class="form-group">
          <label for="address">Cosmos Address</label>
          <input type="text" id="address" name="address" placeholder="cosmos1..." required pattern="^cosmos1[a-z0-9]{38,58}$">
        </div>
        <button type="submit" id="submitBtn">Claim Credits</button>
      </form>

      <p class="info">Addresses must be registered on the TPT Credit testnet via the identity bridge before claiming faucet credits.</p>
    </div>

    <div class="card">
      <h2>Network Info</h2>
      <div class="stats">
        <div class="stat">
          <div class="value"><%= amount %></div>
          <div class="label">Credits per request</div>
        </div>
        <div class="stat">
          <div class="value"><%= chainId %></div>
          <div class="label">Chain ID</div>
        </div>
      </div>
      <div class="stats">
        <div class="stat">
          <div class="value" style="font-size:0.7rem;word-break:break-all;"><%= faucetAddress %></div>
          <div class="label">Faucet Address</div>
        </div>
        <div class="stat">
          <div class="value">ucredit</div>
          <div class="label">Denomination</div>
        </div>
      </div>
    </div>

    <div class="footer">
      <p>Part of the <a href="https://github.com/tpt-platform/tpt-platform" target="_blank">TPT Platform</a></p>
      <p style="margin-top:0.25rem;">Built with universal basic credit principles</p>
    </div>
  </div>

  <script>
    document.getElementById('claimForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const address = document.getElementById('address').value.trim();
      const submitBtn = document.getElementById('submitBtn');
      const alert = document.getElementById('alert');

      alert.style.display = 'none';
      alert.className = 'alert';
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="loading"></span> Processing...';

      try {
        const response = await fetch('/api/claim', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ address }),
        });

        const data = await response.json();

        if (data.success) {
          alert.className = 'alert alert-success';
          alert.style.display = 'block';
          alert.innerHTML = '<strong>Success!</strong> ' + data.message +
            (data.txHash ? '<br><div class="tx-hash">TX: ' + data.txHash + '</div>' : '');
          document.getElementById('address').value = '';
        } else {
          alert.className = 'alert alert-error';
          alert.style.display = 'block';
          alert.innerHTML = '<strong>Error:</strong> ' + (data.message || data.error || 'Unknown error');
        }
      } catch (err) {
        alert.className = 'alert alert-error';
        alert.style.display = 'block';
        alert.innerHTML = '<strong>Network Error:</strong> Could not reach the faucet server. Please try again.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Claim Credits';
      }
    });
  </script>
</body>
</html>