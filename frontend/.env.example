# Copy to .env.local and fill in. Never commit real values.

# HMAC key for session and pre-auth tokens. At least 32 characters. Required: the app refuses
# to sign or verify tokens without it. Generate with: openssl rand -base64 48
JWT_SECRET=

# The prototype merchant account. Required for sign-in.
DEMO_USER_EMAIL=
# Produce with the command in frontend/README.md (format: scrypt$<saltHex>$<keyHex>).
DEMO_USER_PASSWORD_HASH=
# Base32 TOTP secret. Generate with: openssl rand -base32 20 (or any authenticator setup tool).
DEMO_USER_TOTP_SECRET=

# The payments API the dashboard reads from (server-side only; never sent to the browser).
# Example: https://api.tpt-payments.com/v1 or http://localhost:8080/v1 in development.
TPT_API_BASE=
# A secret key the dashboard uses to read payment intents and refunds. Use sk_test_ while developing.
# Without both values the transaction pages show an error and the proxy returns 503.
TPT_DASHBOARD_SECRET_KEY=
