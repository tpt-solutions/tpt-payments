{
  "openapi": "3.0.3",
  "info": {
    "title": "TPT Pay API",
    "description": "TPT Pay - Open Source Stripe Alternative Payment API",
    "version": "2024-06-20",
    "contact": {
      "name": "TPT Pay Support",
      "email": "support@tptpayments.io",
      "url": "https://tptpayments.io"
    }
  },
  "servers": [
    {
      "url": "https://api.tptpayments.io/v1",
      "description": "Production server"
    },
    {
      "url": "https://api-sandbox.tptpayments.io/v1",
      "description": "Sandbox server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key (sk_test_... or sk_live_...)"
      }
    },
    "schemas": {
      "PaymentIntent": {
        "type": "object",
        "required": ["id", "amount", "currency", "status"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the payment intent",
            "example": "pi_3MtwB2eZvKYlo2C2eZvKYlo"
          },
          "object": {
            "type": "string",
            "value": "payment_intent"
          },
          "amount": {
            "type": "integer",
            "description": "Amount intended to be collected by this payment intent (in cents)",
            "example": 2000
          },
          "currency": {
            "type": "string",
            "description": "Three-letter ISO currency code",
            "example": "usd"
          },
          "status": {
            "type": "string",
            "enum": ["requires_payment_method", "requires_confirmation", "requires_action", "processing", "succeeded", "canceled"],
            "description": "Status of the payment intent"
          },
          "client_secret": {
            "type": "string",
            "description": "Client secret used to confirm the payment intent client-side"
          },
          "created": {
            "type": "integer",
            "description": "Timestamp of creation"
          },
          "metadata": {
            "type": "object",
            "description": "Set of key-value pairs for storing additional information"
          }
        }
      },
      "Refund": {
        "type": "object",
        "required": ["id", "amount", "status"],
        "properties": {
          "id": {
            "type": "string",
            "example": "re_3MtwB2eZvKYlo2C2eZvKYlo"
          },
          "object": {
            "type": "string",
            "value": "refund"
          },
          "amount": {
            "type": "integer",
            "example": 1000
          },
          "status": {
            "type": "string",
            "enum": ["pending", "succeeded", "failed", "canceled"]
          },
          "payment_intent": {
            "type": "string",
            "description": "The payment intent this refund is for"
          }
        }
      },
      "Subscription": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "sub_3MtwB2eZvKYlo2C2eZvKYlo"
          },
          "object": {
            "type": "string",
            "value": "subscription"
          },
          "status": {
            "type": "string",
            "enum": ["trialing", "active", "past_due", "canceled", "unpaid"]
          },
          "current_period_start": {
            "type": "integer"
          },
          "current_period_end": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              },
              "code": {
                "type": "string",
                "example": "card_declined"
              },
              "message": {
                "type": "string",
                "example": "The card was declined."
              },
              "param": {
                "type": "string",
                "example": "source"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/payment_intents": {
      "post": {
        "summary": "Create a payment intent",
        "operationId": "createPaymentIntent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "integer",
                    "required": true
                  },
                  "currency": {
                    "type": "string",
                    "required": true
                  },
                  "payment_method_types": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "metadata": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment intent created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentIntent"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List payment intents",
        "operationId": "listPaymentIntents",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "starting_after",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of payment intents"
          }
        }
      }
    },
    "/payment_intents/{intent}": {
      "get": {
        "summary": "Retrieve a payment intent",
        "operationId": "retrievePaymentIntent",
        "parameters": [
          {
            "name": "intent",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment intent retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentIntent"
                }
              }
            }
          }
        }
      }
    },
    "/payment_intents/{intent}/confirm": {
      "post": {
        "summary": "Confirm a payment intent",
        "operationId": "confirmPaymentIntent",
        "parameters": [
          {
            "name": "intent",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment intent confirmed"
          }
        }
      }
    },
    "/payment_intents/{intent}/capture": {
      "post": {
        "summary": "Capture a payment intent",
        "operationId": "capturePaymentIntent",
        "parameters": [
          {
            "name": "intent",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment intent captured"
          }
        }
      }
    },
    "/refunds": {
      "post": {
        "summary": "Create a refund",
        "operationId": "createRefund",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "payment_intent": {
                    "type": "string",
                    "required": true
                  },
                  "amount": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Refund created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refund"
                }
              }
            }
          }
        }
      }
    },
    "/subscriptions": {
      "post": {
        "summary": "Create a subscription",
        "operationId": "createSubscription",
        "responses": {
          "200": {
            "description": "Subscription created successfully"
          }
        }
      }
    },
    "/webhook_endpoints": {
      "post": {
        "summary": "Create a webhook endpoint",
        "operationId": "createWebhookEndpoint",
        "responses": {
          "200": {
            "description": "Webhook endpoint created"
          }
        }
      }
    }
  }
}