# Copy to .env and fill in. Never commit .env.

# Secret key from the TPT Pay dashboard or `tpt keys create`. Test keys start with sk_test_.
TPT_SECRET_KEY=sk_test_replace_me

# Signing secret of the webhook endpoint that points at /webhook (starts with whsec_).
TPT_WEBHOOK_SECRET=whsec_replace_me

# Optional: the API base URL, for a self-hosted or local deployment. Leave empty for the default.
# TPT_API_BASE=http://localhost:8080/v1

# Port for this server.
PORT=3000
