{
  "name": "@tpt/pay",
  "version": "0.1.0",
  "description": "TPT Pay API client for JavaScript and TypeScript (pre-release)",
  "license": "(MIT OR Apache-2.0)",
  "author": "TPT Solutions",
  "keywords": ["payments", "tpt", "api", "sdk"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tpt-solutions/tpt-payments.git",
    "directory": "packages/tpt-pay"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.mts",
        "default": "./dist/webhooks.mjs"
      },
      "require": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      }
    }
  },
  "files": [
    "dist/"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/webhooks.ts --format cjs,esm --dts --clean --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint src test --ext .ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsup": "^8.0.2",
    "typescript": "^5.4.0"
  }
}
