{
  "name": "@tpt/pay",
  "version": "0.1.0",
  "description": "TPT Pay API client for JavaScript and TypeScript (pre-release)",
  "license": "(MIT OR Apache-2.0)",
  "author": "TPT Solutions",
  "keywords": [
    "payments",
    "tpt",
    "api",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tpt-solutions/tpt-payments.git",
    "directory": "packages/tpt-pay"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.mts",
        "default": "./dist/webhooks.mjs"
      },
      "require": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      }
    }
  },
  "files": [
    "dist/"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/webhooks.ts --format cjs,esm --dts --clean --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint src test --ext .ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "generate": "openapi-typescript ../tpt-pay-core/api/openapi.json -o src/generated/openapi.ts"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "openapi-typescript": "^7.13.0",
    "ts-jest": "^29.1.2",
    "tsup": "^8.5.1",
    "typescript": "5.9.3"
  }
}
