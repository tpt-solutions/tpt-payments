{
  "name": "@tpt/pay",
  "version": "1.0.0",
  "description": "TPT Pay JavaScript SDK",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "browser": "./dist/browser/tpt-pay.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "browser": "./dist/browser/tpt-pay.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:browser && npm run build:types",
    "build:cjs": "tsc --module commonjs --outDir dist/cjs",
    "build:esm": "tsc --module esnext --outDir dist/esm",
    "build:browser": "esbuild src/index.ts --bundle --minify --sourcemap --outfile=dist/browser/tpt-pay.js --global-name=TPTPay",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist/types",
    "test": "jest",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "payments",
    "tpt",
    "api",
    "sdk"
  ],
  "author": "TPT Payments",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.0",
    "esbuild": "^0.20.0",
    "jest": "^29.7.0",
    "@types/node": "^20.12.0",
    "@types/crypto-js": "^4.2.0"
  },
  "dependencies": {
    "crypto-js": "^4.2.0"
  }
}