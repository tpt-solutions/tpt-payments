# TPT Pay Core — environment configuration
# Copy this file to .env and fill in values for local development.
# Never commit .env to version control.

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_ADDR=:8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://tptpay:tptpay@localhost:5432/tptpay?sslmode=disable
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5

# ── NATS JetStream ────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222
# NATS_CREDS_FILE=/path/to/nats.creds  # for production with NKey auth

# ── HashiCorp Vault ───────────────────────────────────────────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
# VAULT_ROLE_ID=...     # for AppRole auth in production
# VAULT_SECRET_ID=...

# ── Redis (rate limiting) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Adapter ──────────────────────────────────────────────────────────────────
# Which CardNetworkAdapter to use: sandbox | bank_sponsor | direct_acquiring
ADAPTER_TYPE=sandbox

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development   # development | staging | production
LOG_LEVEL=debug       # debug | info | warn | error

# ── Webhook delivery ──────────────────────────────────────────────────────────
WEBHOOK_WORKER_CONCURRENCY=10
WEBHOOK_MAX_ATTEMPTS=15
WEBHOOK_RETRY_WINDOW=72h

# Encrypts webhook signing secrets at rest. Required: the server will not start without it.
# Generate with: openssl rand -base64 32
WEBHOOK_SECRET_KEY=

# Production: wrap the webhook key with Vault Transit and set only the ciphertext.
# VAULT_TRANSIT_KEY=tpt-webhooks
# VAULT_TRANSIT_MOUNT=transit
# VAULT_WEBHOOK_KEY_CIPHERTEXT=vault:v1:...

# Merchant rules (optional): a JSON file of flag and block rules, see policy.example.json.
# POLICY_FILE=./policy.example.json
